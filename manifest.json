{
  "manifest_version": 3,
  "name": "شەمشەر ئېلان توسقۇچ | Shemsher AdBlocker",
  "short_name": "Shemsher",
  "version": "3.2.0",
  "description": "شەمشەر ئېلان توسقۇچ (Shemsher AdBlocker) — قارا ئېكرانسىز، ساقلاشسىز YouTube ۋە بارلىق تور بەتلەردىكى ئېلانلارنى پۈتۈنلەي توسىدىغان بىخەتەر قالقان.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "شەمشەر ئېلان توسقۇچ (Shemsher AdBlocker)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page-world.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline';"
  },
  "minimum_chrome_version": "102"
}
